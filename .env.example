# Copy to .env and fill in. .env is git-ignored.

# --- Anthropic ---
# Required only when ENGINE=claude. With ENGINE=stub the app runs fully offline.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Engine selection ---
# stub   = deterministic canned analysis, no network, no key (default; used by tests)
# claude = real two-stage Claude pipeline
ENGINE=stub

# --- Model tiering (see README: "Why Sonnet, not Opus") ---
EXTRACT_MODEL=claude-sonnet-5
EXTRACT_EFFORT=medium
PRIORITIZE_MODEL=claude-sonnet-5
PRIORITIZE_EFFORT=high

# --- Session security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-generate-a-real-one
# Leave false for local HTTP. A Secure cookie is NOT sent over http:// —
# setting this true locally makes login silently redirect back to /login.
COOKIE_SECURE=false

# --- Demo determinism ---
# Anchors relative-date resolution ("do patku") so the adversarial fixture
# keeps working regardless of today's real date. Unset = use real now().
NOW_OVERRIDE=2026-08-28T09:00:00+02:00
USER_TIMEZONE=Europe/Prague

DATABASE_URL=sqlite+aiosqlite:///./deadlines.db
